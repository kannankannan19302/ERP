{
  "name": "agrierp-backend",
  "version": "1.0.0",
  "description": "AgriERP Backend API Server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "babel src -d dist",
    "docker:build": "docker build -t agrierp-backend .",
    "docker:run": "docker run -p 3000:3000 agrierp-backend"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.11.0",
    "knex": "^3.0.1",
    "pg": "^8.11.3",
    "mssql": "^10.0.1",
    "oracledb": "^6.0.3",
    "redis": "^4.6.10",
    "nodemailer": "^6.9.7",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "aws-sdk": "^2.1489.0",
    "socket.io": "^4.7.4",
    "cron": "^3.1.6",
    "winston": "^3.11.0",
    "express-validator": "^7.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-oauth2": "^1.7.0",
    "graphql": "^16.8.1",
    "apollo-server-express": "^3.12.1",
    "dataloader": "^2.2.2",
    "uuid": "^9.0.1",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "xlsx": "^0.18.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.3",
    "twilio": "^4.19.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/cli": "^7.23.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "erp",
    "agriculture",
    "nodejs",
    "express",
    "api",
    "postgresql",
    "sqlserver",
    "oracle"
  ],
  "author": "AgriERP Team",
  "license": "MIT"
}